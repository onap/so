<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    <contextListener class="org.onap.so.logger.LoggerStartupListener" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>org.onap.so.logger.SoJsonLogFormatter</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="org.springframework" level="WARN" />
    <logger name="org.camunda.bpm.engine.jobexecutor" level="WARN" />
    <logger name="org.camunda.bpm.engine.impl.persistence.entity.JobEntity" level="WARN" />
    <logger name="org.reflections" level="ERROR" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
